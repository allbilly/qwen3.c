+void pp_root(int category,double start) { if(!pp_active)return;roots[category].ms+=pp_clock()-start;roots[category].calls++; }
+void pp_detail(int category,double start,uint64_t bytes) { if(!pp_active)return;Counter *c=&detail[pp_owner][category];c->ms+=pp_clock()-start;c->calls++;c->bytes+=bytes; }
+void pp_submit(double start,int64_t driver_ns,int result) {
+    if(!pp_active)return;
+    double wall=pp_clock()-start,driver=driver_ns/1e6;
+    Counter *c=&detail[pp_owner][PP_SUBMIT];c->ms+=wall;c->calls++;
+    if(result<0||driver_ns<=0||driver>wall+.01){c->invalid_driver_times++;return;}
+    c->driver_ms+=driver;
+    if(c->calls==1||driver<c->driver_min_ms)c->driver_min_ms=driver;
+    if(driver>c->driver_max_ms)c->driver_max_ms=driver;
+}
